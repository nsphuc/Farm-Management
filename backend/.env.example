# ==============================================================================
# FARM SAAS BACKEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Thiết lập biến môi trường chạy Backend độc lập hoặc chạy cùng MySQL Docker

# Port chạy dịch vụ backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Kết nối cơ sở dữ liệu MySQL (Port 3309 theo cấu hình docker-compose.yml)
DB_URL=jdbc:mysql://localhost:3309/farm_saas_dev?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=123456

# Cấu hình bảo mật JWT (DEC-05 / D-12)
APP_JWT_SECRET=farm-saas-platform-super-secret-key-that-is-at-least-256-bits-long-2026!
APP_JWT_ACCESS_EXPIRATION_MS=1800000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
