# ==============================================================================
# FARM SAAS PLATFORM - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# SAO CHÉP FILE NÀY THÀNH .env ĐỂ CẤU HÌNH CHO MÔI TRƯỜNG PHÁT TRIỂN / TRIỂN KHAI
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env CHỨA THÔNG TIN NHẠY CẢM VÀO GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOCKER COMPOSE / MYSQL DATABASE CONTAINER
# ------------------------------------------------------------------------------
MYSQL_DATABASE=farm_saas_dev
MYSQL_ROOT_PASSWORD=123456
MYSQL_PORT=3309

# ------------------------------------------------------------------------------
# 2. BACKEND SPRING BOOT (Java 21 + Spring Boot 3.3.x)
# ------------------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Datasource Connection (Kết nối tới MySQL trên port 3309)
DB_URL=jdbc:mysql://localhost:3309/farm_saas_dev?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=123456
# JWT Security Configuration (Tuân thủ DEC-05 / D-12)
# Khóa bí mật tối thiểu 256 bits (32 ký tự)
APP_JWT_SECRET=farm-saas-platform-super-secret-key-that-is-at-least-256-bits-long-2026!
APP_JWT_ACCESS_EXPIRATION_MS=1800000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 3. FRONTEND VITE (React 18 + Vite 5)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_PORT=5173
